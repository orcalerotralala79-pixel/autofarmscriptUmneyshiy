-- === Таймер сессии ===
local startTime = os.clock()
RunService.Heartbeat:Connect(function()
	local elapsed = os.clock() - startTime
	local h = math.floor(elapsed / 3600)
	local m = math.floor((elapsed % 3600) / 60)
	local s = math.floor(elapsed % 60)
	timeLabel.Text = string.format("%02d:%02d:%02d", h, m, s)
end)

-- ============================================================
-- === Auto Farm: удар + клавиши ===
-- ============================================================
local function click()
	local char = player.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then
		tool:Activate() -- работает и на ПК, и на телефоне
	end
end

local function pressKey(key)
	VIM:SendKeyEvent(true, key, false, game)
	task.wait(0.05)
	VIM:SendKeyEvent(false, key, false, game)
end

-- ============================================================
-- === Привязка к случайному игроку (независимый процесс) ===
-- ============================================================
local afEnabled = false
local currentTarget = nil
local targetConn = nil
local lockThread = nil
local followConn = nil

local function getRandomTarget()
	local candidates = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then return nil end
	return candidates[math.random(1, #candidates)]
end

local function teleportToTarget(targetPlayer)
	local myChar = player.Character
	local targetChar = targetPlayer.Character
	if not myChar or not targetChar then return end

	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	if not myRoot or not targetRoot then return end

	myRoot.CFrame = targetRoot.CFrame -- телепорт прямо в цель
end

local function startFollowing()
	if followConn then followConn:Disconnect() end
	followConn = RunService.Heartbeat:Connect(function()
		if afEnabled and currentTarget and currentTarget.Character then
			teleportToTarget(currentTarget)
		end
	end)
end

local function stopFollowing()
	if followConn then
		followConn:Disconnect()
		followConn = nil
	end
end

local function pickNewTarget()
	if targetConn then
		targetConn:Disconnect()
		targetConn = nil
	end

	local newTarget = getRandomTarget()
	currentTarget = newTarget

	if newTarget then
		local hum = newTarget.Character:FindFirstChild("Humanoid")
		if hum then
			targetConn = hum.Died:Connect(function()
				if afEnabled then
					task.wait(0.3)
					pickNewTarget()
				end
			end)
		end
	end
end

local function targetWatchLoop()
	while afEnabled do
		if currentTarget then
			local stillValid = currentTarget.Parent ~= nil
				and currentTarget.Character
				and currentTarget.Character:FindFirstChild("Humanoid")
				and currentTarget.Character.Humanoid.Health > 0

			if not stillValid then
				pickNewTarget()
			end
		else
			pickNewTarget()
		end
		task.wait(1)
	end
end

-- ============================================================
-- === Макрос ударов (отдельный, независимый от привязки) ===
-- ============================================================
local afThread = nil

local function afLoop()
	while afEnabled do
		for i = 1, 3 do click() end
		pressKey(Enum.KeyCode.One)

		task.wait(1)
		if not afEnabled then break end

		for i = 1, 3 do click() end
		pressKey(Enum.KeyCode.Two)

		task.wait(1)
		if not afEnabled then break end

		pressKey(Enum.KeyCode.Two)

		task.wait(1)
		if not afEnabled then break end

		pressKey(Enum.KeyCode.Three)
		pressKey(Enum.KeyCode.Four)

		if afEnabled then
			task.wait(20) -- пауза перед новым циклом макроса
		end
	end
end

-- ============================================================
-- === Переключатель AF ON/OFF ===
-- ============================================================
toggleBtn.MouseButton1Click:Connect(function()
	afEnabled = not afEnabled

	if afEnabled then
		knob:TweenPosition(UDim2.new(1, -23, 0.5, -10), "Out", "Quad", 0.15, true)
		toggleBg.BackgroundColor3 = Color3.fromRGB(0, 255, 127)

		pickNewTarget()
		lockThread = task.spawn(targetWatchLoop)
		startFollowing()
		afThread = task.spawn(afLoop)
	else
		knob:TweenPosition(UDim2.new(0, 3, 0.5, -10), "Out", "Quad", 0.15, true)
		toggleBg.BackgroundColor3 = Color3.fromRGB(80, 80, 80)

		if targetConn then
			targetConn:Disconnect()
			targetConn = nil
		end
		currentTarget = nil
		stopFollowing()
	end
end)
